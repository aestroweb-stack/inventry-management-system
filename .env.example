# MYRAA Inventory: production server-side Gemini (Google AI Studio API key)
# Keep all secrets in Railway Variables, never frontend or Git.
MYRAA_CLOUD_PROVIDER=gemini
GEMINI_API_KEY=
MYRAA_CLOUD_MODEL=gemini-3.8-flash

# Required operator login. Use strong, independent secrets.
APP_PASSWORD=
APP_SESSION_SECRET=
MYRAA_REQUIRE_AUTH=1
# APP_ALLOWED_ORIGINS=https://your-app.up.railway.app

# Set DATABASE_URL to Railway's PostgreSQL variable reference, not temporary SQLite.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Mount a persistent Railway volume at /data (or adjust path accordingly).
PRODUCT_IMAGE_DIR=/data/product_images

# Separate, random 32+ character secrets for protected inventory change confirmation and MCP.
MYRAA_CONFIRMATION_SECRET=
INVENTORY_MCP_API_KEY=

# Optional custom MCP/desktop integration (NOT needed for Railway MYRAA chat/voice).
DISHA_MCP_API_KEY=
INVENTORY_MCP_ALLOWED_HOSTS=
INVENTORY_MCP_ALLOWED_ORIGINS=

# Optional database tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=

# Optional dedicated SigLIP inference service for stricter visual similarity.
VISUAL_AI_URL=
VISUAL_AI_API_KEY=
VISUAL_AI_TIMEOUT_SECONDS=120
VISUAL_MATCH_MIN_SCORE=0.90
VISUAL_MATCH_MIN_MARGIN=0.10
VISUAL_SEARCH_DEV_MAX_CATALOG=500
VISUAL_SEARCH_RPM=30
